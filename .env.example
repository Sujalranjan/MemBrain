# Copy to .env and adjust as needed. Never commit .env.
# Every setting has a working default for local development with docker compose.

# DATABASE_URL=postgresql+asyncpg://membrain:membrain@localhost:5432/membrain
# WORKSPACE=engineering
# CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# LOG_LEVEL=INFO

# Embeddings (local, via fastembed). Changing the model requires a model with the same
# dimension, or a new migration and re-embedding.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval tuning
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RRF_K=10
# KEYWORD_WEIGHT=1.0
# BM25_K1=1.2
# BM25_B=0.75
# CANDIDATE_POOL=50
# RETENTION_WEIGHT=0.15

# Grounded answers ("Ask Anything") use Claude. Without a key, the app still works and
# shows the closest memories instead of a generated answer.
# ANTHROPIC_API_KEY=
# ANSWER_MODEL=claude-opus-5-5
# ANSWER_EFFORT=low
# ANSWER_SOURCES=6

# Knowledge graph edge selection
# GRAPH_NEIGHBORS=3
# GRAPH_MARGIN=0.01
# GRAPH_MIN_SIMILARITY=0.5

# Tests use a separate database (created automatically)
# TEST_DATABASE_URL=postgresql+asyncpg://membrain:membrain@localhost:5432/membrain_test

# Document ingestion. Uploads are queued in Postgres and processed by a background worker.
# MAX_UPLOAD_BYTES=10485760
# MAX_DOCUMENT_CHARS=300000
# Set to false on the API when running dedicated workers with `python -m app.worker`.
# INGESTION_WORKER=true
# INGESTION_POLL_SECONDS=2
# INGESTION_MAX_ATTEMPTS=3
# INGESTION_STALE_SECONDS=600

# Authentication and rate limiting. With AUTH_ENABLED=true, create keys with `python -m app.cli create-key`.
# AUTH_ENABLED=false
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=120
# ASK_RATE_LIMIT_PER_MINUTE=10
